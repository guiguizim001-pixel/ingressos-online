{
  "name": "seu-ingresso",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "admin:create": "node scripts/admin.js",
    "reconcile": "node scripts/reconcile.js",
    "worker": "node src/worker.js",
    "setup": "node scripts/setup.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node scripts/check.js",
    "db:local": "node scripts/dev-db.js",
    "start:easy": "node scripts/easy-start.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "mercadopago": "3.6.2",
    "multer": "2.5.0",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "supertest": "7.3.2"
  }
}
